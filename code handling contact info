#include <stdio.h>
#include <string.h>

struct Contact
{
    char name[30];
    char phone[15];
};

int main()
{
    struct Contact c;
    FILE *fp;
    int choice;
    char search[30];

    do
    {
        printf("\n--- CONTACT MANAGEMENT ---\n");
        printf("1. Add Contact\n");
        printf("2. Search Contact\n");
        printf("3. Update Contact\n");
        printf("4. Delete Contact\n");
        printf("5. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        if(choice == 1)
        {
            fp = fopen("contact.txt", "a");

            printf("Enter name: ");
            scanf("%s", c.name);

            printf("Enter phone: ");
            scanf("%s", c.phone);

            fprintf(fp, "%s %s\n", c.name, c.phone);
            fclose(fp);

            printf("Contact added.\n");
        }

        else if(choice == 2)
        {
            fp = fopen("contact.txt", "r");

            printf("Enter name to search: ");
            scanf("%s", search);

            while(fscanf(fp, "%s %s", c.name, c.phone) != EOF)
            {
                if(strcmp(c.name, search) == 0)
                {
                    printf("Name: %s\n", c.name);
                    printf("Phone: %s\n", c.phone);
                }
            }

            fclose(fp);
        }

        else if(choice == 3)
        {
            fp = fopen("contact.txt", "r");

            FILE *temp = fopen("temp.txt", "w");

            printf("Enter name to update: ");
            scanf("%s", search);

            while(fscanf(fp, "%s %s", c.name, c.phone) != EOF)
            {
                if(strcmp(c.name, search) == 0)
                {
                    printf("Enter new phone: ");
                    scanf("%s", c.phone);
                }

                fprintf(temp, "%s %s\n", c.name, c.phone);
            }

            fclose(fp);
            fclose(temp);

            remove("contact.txt");
            rename("temp.txt", "contact.txt");

            printf("Contact updated.\n");
        }

        else if(choice == 4)
        {
            fp = fopen("contact.txt", "r");

            FILE *temp = fopen("temp.txt", "w");

            printf("Enter name to delete: ");
            scanf("%s", search);

            while(fscanf(fp, "%s %s", c.name, c.phone) != EOF)
            {
                if(strcmp(c.name, search) != 0)
                    fprintf(temp, "%s %s\n", c.name, c.phone);
            }

            fclose(fp);
            fclose(temp);

            remove("contact.txt");
            rename("temp.txt", "contact.txt");

            printf("Contact deleted.\n");
        }

    } while(choice != 5);

    return 0;
}
